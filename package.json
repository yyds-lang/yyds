{
  "name": "yyds-lang-workspace",
  "version": "0.0.7",
  "private": true,
  "description": "YYDS language monorepo workspace.",
  "homepage": "https://github.com/yyds-lang/yyds#readme",
  "bugs": {
    "url": "https://github.com/yyds-lang/yyds/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyds-lang/yyds"
  },
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run website#dev",
    "build": "vp run -r build",
    "preview": "vp run website#preview",
    "test": "vp run -r test",
    "check": "vp run -r check",
    "prepare": "vp config",
    "release": "bumpp -r"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.2.2"
}
